# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pocket_buddy

# Auth (REQUIRED - generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-key-here

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret

# Python AI Backend (walletmate-api)
# NEXT_PUBLIC_API_URL must be reachable from the browser.
# API_URL is used by Next.js server routes; in Docker this can be http://api:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
