# Required
OPENAI_API_KEY=sk-your-openai-key
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Public URLs
# For local Docker, keep these as localhost.
# For a server, change them to your real public URLs, for example:
# AUTH_URL=https://walletmate.example.com
# NEXT_PUBLIC_API_URL=https://walletmate-api.example.com
# CORS_ORIGINS=https://walletmate.example.com
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Internal API URL used by Next.js server routes inside Docker.
API_URL=http://api:8000

# Optional OpenAI-compatible settings
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=

# Local Postgres defaults
POSTGRES_USER=walletmate
POSTGRES_PASSWORD=walletmate
POSTGRES_DB=walletmate
POSTGRES_PORT=5432
DATABASE_URL=postgresql://walletmate:walletmate@postgres:5432/walletmate

# Published ports
PWA_PORT=3000
API_PORT=8000
